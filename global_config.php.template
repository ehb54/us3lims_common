## define all possible clusters for this server.
##
## CLUSTER CONFIGURATION COMES FROM THREE LEVELS. This file, the common one,
## defines what each cluster IS: its hostname, queue, sizing and limits, in
## $cluster_details below. Which of those clusters a given LIMS instance may
## actually use is a separate decision, made in $cluster_configuration in a
## cluster_config.php, and that file is looked for at two levels in turn:
##
##   1. dbinst    <instance dir>/cluster_config.php
##                the instance's own file, if it has one
##   2. newlims   <web root>/uslims3_newlims/cluster_config.php
##                the shared default from the registration interface
##
## The first file found wins outright. The levels do not merge, because each
## one assigns $cluster_configuration whole.
##
## A cluster is offered, and accepted, only when it is active in BOTH places:
## 'active' => true here, and 'active' => true in the winning
## $cluster_configuration. Both lib/utility.php (which builds the queue-setup
## list) and class/jobsubmit.php (which decides what a submission may reach)
## apply that intersection, so "not offered" and "not accepted" are one
## decision rather than two that can drift apart.

## SSH-Slurm cluster config keys:
##
##   Required:
##     name       string  SSH hostname (used as login target if 'login' not set)
##     login      string  SSH login target, e.g. user@host (overrides name)
##     workdir    string  base path on submithost; job subdirectory appended at runtime
##     sshport    int     SSH port (normally 22)
##     queue      string  Slurm partition name
##     maxtime    int     maximum walltime in minutes; the computed estimate and
##                        wall_override are both clamped to it (0 = unlimited:
##                        no clamp, and 00:00:00 when usemaxtime is set)
##     ppn        int     procs per node
##     ppbj       int     procs per base job
##     maxproc    int     maximum total procs
##
##   Environment:
##     env_script_lines  string  verbatim shell preamble written into the Slurm script
##                               before the MPI launch line; include module commands,
##                               PATH/LD_LIBRARY_PATH exports, etc.
##
##   MPI launcher:
##     mpi_launcher  string  'mpirun' (default) | 'srun' | 'ibrun'
##                           mpirun: standard OpenMPI, used for most clusters
##                           srun:   Slurm-native; use for Anvil, Expanse
##                           ibrun:  TACC wrapper; required for Lonestar6, Stampede2
##
##   Optional scheduler/resource keys:
##     usemaxtime    bool  use maxtime directly instead of computed estimate;
##                         set maxtime=0 for unlimited (emits 00:00:00 to Slurm)
##     wall_override int   fixed walltime in minutes (overrides computed; ignored if
##                         usemaxtime; still clamped to maxtime)
##     ssh_host_key_policy string  'accept-new' (default) trusts an unknown host
##                         key on first use and still refuses a changed one.
##                         'yes' requires the key to be installed in advance and
##                         is right for a provisioned cluster, where first-use
##                         trust buys nothing. No other value is accepted.
##     sbatch_directives array  site-specific batch directives, for example a
##                              --mem-per-cpu or --exclusive policy. Each entry
##                              is emitted verbatim, so it must be a complete
##                              single line beginning "#SBATCH " with no
##                              embedded newline; the emitter rejects anything
##                              else rather than writing a malformed script.
##                              Replaces mempercore. A config still carrying
##                              mempercore and no sbatch_directives keeps
##                              working: it is read as --mem-per-cpu.
##
##   Sizing keys. These are three independent axes -- do not assume setting
##   one implies another. A co-located appliance with more than one compute
##   node, for instance, sets fixed_capacity without single_node.
##
##     TOPOLOGY
##     single_node   bool  confine the job to exactly one node (default false).
##                         This is a constraint on the plan, not a collapse
##                         applied after sizing: maxproc must not exceed ppn,
##                         and a plan whose total rank count will not fit on
##                         one node is refused rather than silently shrunk.
##
##     CAPACITY
##     fixed_capacity    bool  size jobs to this box's own core count rather
##                             than requesting a share of a large shared
##                             scheduler (default false). Set this for USiaB
##                             appliances and small dedicated clusters.
##     procs_per_mgroup  int   floor on the ranks allotted to one parallel
##                             model group (default 16), capped by ppn so it
##                             can never ask for more than a node holds. It
##                             sets that floor and the GA deme floor. It no
##                             longer sets the group ceiling: the ceiling is
##                             maxproc divided by the ranks one intact group
##                             actually needs, which procs_per_mgroup only
##                             raises from below. Only consulted when
##                             fixed_capacity is set.
##
##     PERFORMANCE
##     cg_time_multiplier  float  extra walltime factor for custom-grid (CG)
##                                methods on this box (default 4.0). Only
##                                consulted when fixed_capacity is set; a
##                                fast fixed-capacity box should lower it.
##
##   Exception-only remote execution policy. Normal clusters omit this key.
##   When operational evidence shows one site needs a different wall-clock
##   budget, add only the affected field. remote_exec validates the name, type,
##   and safe range before making a connection; retry and breaker policy cannot
##   be overridden here.
##
##     'remote_exec_overrides' => [
##         'connect_timeout_seconds' => 30,   # allowed 1..300
##         'command_timeout_seconds' => 180,  # allowed 1..3600
##         'copy_timeout_seconds'    => 1800, # allowed 1..86400
##     ]
##
##   DEPRECATED:
##     pmg           bool  parallel Monte Carlo group support enabled
##     pmgonly       bool  cluster accepts PMG jobs only

