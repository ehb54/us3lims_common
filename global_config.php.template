## SSH-Slurm configuration:
## Required keys:
##   active    bool    enable the cluster globally
##   name      string  hostname; SSH defaults to us3@name
##   workdir   string  remote directory prefix for per-request directories
##   sshport   int     SSH port
##   queue     string  Slurm partition
##   maxtime   int     walltime limit in minutes; 0 means unlimited
##   ppn       int     task capacity per node
##   ppbj      int     tasks per base job
##   maxproc   int     maximum tasks per job
##
## Optional connection and script settings:
##   login                string  SSH user@host, overriding us3@name
##   ssh_host_key_policy  string  accept-new (default), or yes for preinstalled keys
##   env_script_lines     string  shell preamble for modules and environment variables
##   mpi_launcher         string  mpirun (default), srun, or ibrun
##   sbatch_directives    array   complete single-line "#SBATCH " directives
##                               mempercore supplies --mem-per-cpu if this is empty
##   usemaxtime           bool    use maxtime directly (0 emits 00:00:00)
##   wall_override        int     fixed walltime in minutes unless usemaxtime is set
##                               estimates and overrides are capped by maxtime
##
## Independent sizing settings:
##   single_node         bool   require one node and maxproc <= ppn (default false)
##   fixed_capacity      bool   apply the per-group floor below (default false)
##   procs_per_mgroup    int    per-group rank floor, capped by ppn (default 16);
##                             applies only with fixed_capacity, including GA demes
##   cg_time_multiplier  float  extra CG walltime factor with fixed_capacity (default 4)
##   pmg                 bool   enable parallel Monte Carlo groups
##   pmgonly             bool   offer this cluster only for PMG jobs
##
## Optional timeout exceptions; omit fields that use remote_exec defaults.
## Retry and breaker policies cannot be overridden here.
